# ==============================================================================
# DocuMind — Production & Development Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Backend Provider
# Choose: 'gemini' (default), 'openai', 'groq', or 'offline'
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google Gemini API Key (get free at https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (optional alternative)
OPENAI_API_KEY=

# Groq API Key (optional ultra-fast alternative)
GROQ_API_KEY=


# ------------------------------------------------------------------------------
# 2. Managed Cloud Storage & PostgreSQL (Supabase)
# Set these when deploying to cloud hosting (Streamlit Cloud, Render, Fly.io, etc.)
# ------------------------------------------------------------------------------
# Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=

# Supabase Anon / Public Key (safe for client queries with Row Level Security)
SUPABASE_KEY=

# Supabase Service Role Key (secret admin key, keep strictly confidential)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket for private PDF storage (default: documind-documents)
SUPABASE_STORAGE_BUCKET=documind-documents

# Storage Mode: 'auto' (uses Supabase if configured, otherwise local), 'local', or 'supabase'
DOCUMIND_STORAGE_MODE=auto


# ------------------------------------------------------------------------------
# 3. Local Development / Fallback Storage Paths
# Used when Supabase is not configured or in offline/local testing
# ------------------------------------------------------------------------------
DOCUMIND_DB_PATH=data/documind.db
CHROMA_PERSIST_DIR=chroma_db
UPLOADS_DIR=data/uploads


# ------------------------------------------------------------------------------
# 4. Local Embedding Model
# Runs 100% offline on local CPU/device (no API charges or network latency)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2


# ------------------------------------------------------------------------------
# 5. Application Security & Session Persistence
# Cryptographic secret used for HMAC-SHA256 session tokens.
# Change to a strong random 32+ character string in production!
# ------------------------------------------------------------------------------
SECRET_KEY=documind-production-secret-change-this-in-production-deployments
